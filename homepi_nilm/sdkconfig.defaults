# sdkconfig.defaults
CONFIG_IDF_TARGET="esp32s3"

# Flash 4MB (XIAO ESP32-S3: kept at 4MB, the layout the deployed devices already have)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Console ────────────────────────────────────────────────────
# v2.6.0: UART0 console moved off GPIO43/44, which carry the Teensy link (GPIO43 = TX to the Teensy
# for the remote update). TX GPIO7 (D8) and RX GPIO8 (D9) are unconnected; logs stay on USB-JTAG.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=7
CONFIG_ESP_CONSOLE_UART_RX_GPIO=8
# USB-JTAG en secondaire (idf.py monitor continue à marcher sur PC)
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# TLS / mbedTLS
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=8192
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_TLS_INSECURE=n
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=n

# MQTT
CONFIG_MQTT_BUFFER_SIZE=4096

# NTP
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# OTA
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
# Rollback: an image that never confirms itself is reverted (no inline comment: it voids the value)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Logs
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30