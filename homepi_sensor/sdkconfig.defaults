# sdkconfig.defaults
CONFIG_IDF_TARGET="esp32c3"

# Flash 4MB (Xiao ESP32-C3)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Console ────────────────────────────────────────────────────
# UART comme console primaire (fonctionne avec ou sans USB host)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# USB-JTAG en secondaire (idf.py monitor continue à marcher sur PC)
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# TLS / mbedTLS
# v2.4.3: buffers allocated only while a record is in flight (heap_min was 9.5 KB on the sensor with
# bh1750+bme688+sps30+sgp41). The record size stays 16 KB in: nginx sends 16 KB records during an OTA
# download. (CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN, here until v2.4.2, is not an IDF 5.3 option: ignored.)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_TLS_INSECURE=n
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=n

# MQTT: default 1024-byte buffers (CONFIG_MQTT_BUFFER_SIZE, here until v2.4.2, is ignored without
# CONFIG_MQTT_USE_CUSTOM_CONFIG). An OTA command is about 550 bytes.

# NTP
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# OTA
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
# Rollback: an image that never confirms itself is reverted (no inline comment: it voids the value)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Logs
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30